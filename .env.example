# Personal Access Token from https://account.smartthings.com/tokens
# Scopes needed: devices (list / read / execute) and locations (read).
# NOTE: PATs created after Jan 2025 are only valid for 24 hours.
SMARTTHINGS_TOKEN=

# The washer's device id. Run `npm run probe` to list the devices on your
# account and print it. Kept here rather than in the repo because it identifies
# one specific appliance.
SMARTTHINGS_DEVICE_ID=

# Port for the web UI (default 8099)
# PORT=8099
